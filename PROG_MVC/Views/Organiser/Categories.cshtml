@model List<EventCategoryDto>
@{
    ViewData["Title"] = "Categories";
    var eventId = (int)(ViewBag.EventId ?? 0);
}
<h2>Categories for Event @eventId</h2>
<form asp-action="AddCategory" asp-route-eventId="@eventId" method="post" class="row g-2 mb-3">
    @Html.AntiForgeryToken()
    <div class="col"><input name="Name" class="form-control" placeholder="Name" required /></div>
    <div class="col"><input name="Distance" class="form-control" placeholder="Distance" type="number" step="0.01" required /></div>
    <div class="col"><input name="MaxParticipants" class="form-control" placeholder="Max" type="number" value="100" /></div>
    <div class="col"><input name="Price" class="form-control" placeholder="Price" type="number" step="0.01" required /></div>
    <div class="col"><button class="btn btn-success" type="submit">Add</button></div>
</form>
<table class="table">
    <thead><tr><th>Name</th><th>Distance</th><th>Max</th><th>Price</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.Distance</td>
            <td>@c.MaxParticipants</td>
            <td>@c.Price</td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="EditCategory" asp-route-eventId="@eventId" asp-route-categoryId="@c.Id">Edit</a>
                <form asp-action="DeleteCategory" asp-route-eventId="@eventId" asp-route-categoryId="@c.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>